{
  "name": "hotel-continent",
  "private": true,
  "version": "1.0.0",
  "description": "Hotel Continent — public website and admin panel by noMirage",
  "author": "noMirage",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
